RewriteEngine On

# Redirect www to canonical non-www hostname
RewriteCond %{HTTP_HOST} ^www\.movinginmobile\.com$ [NC]
RewriteRule ^ https://movinginmobile.com%{REQUEST_URI} [R=301,L]

# Preserve Hostinger's internal builds protection
RewriteRule ^\.builds - [F,L]

# Serve existing files and directories normally
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# React Router SPA fallback
RewriteRule ^ index.html [L]